{
  "rules": {
    ".read": true,
    ".write": false,

    "buses": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['dir','trip','ts']) || newData.val() == null"
      }
    },

    "coords": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "viapoints": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "zones": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "notice": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "counts": {
      ".read": true,
      "$date": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },

    "handoff": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "journal": {
      ".read": true,
      "$date": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },

    "drivers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "stickers": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": "!data.exists() || (auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())) || (data.exists() && newData.val() == null && (now - data.child('ts').val()) < 1800000)",
        ".validate": "newData.hasChildren(['lat','lng','kind','ts']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber() && newData.child('kind').isString() && newData.child('kind').val().length <= 16 && (!newData.hasChild('label') || (newData.child('label').isString() && newData.child('label').val().length <= 60))"
      }
    },

    "stats": {
      ".read": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      "$date": {
        "sessions": {
          "$sid": {
            ".write": true,
            ".validate": "newData.hasChildren(['ts','ev']) && newData.child('ts').isNumber() && newData.child('ev').hasChildren() && $sid.length <= 32"
          }
        }
      }
    }
  }
}
