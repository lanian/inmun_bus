{
  "rules": {
    ".read": true,
    ".write": false,

    "buses": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['dir','trip','ts']) || newData.val() == null"
      }
    },

    "coords": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "viapoints": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "zones": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "notice": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "counts": {
      ".read": true,
      "$date": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },

    "handoff": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "journal": {
      ".read": true,
      "$date": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
      }
    },

    "drivers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "stickers": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": "!data.exists() || (auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())) || (data.exists() && newData.val() == null && (now - data.child('ts').val()) < 1800000)",
        ".validate": "newData.hasChildren(['lat','lng','kind','ts']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber() && newData.child('kind').isString() && newData.child('kind').val().length <= 16 && (!newData.hasChild('label') || (newData.child('label').isString() && newData.child('label').val().length <= 60))"
      }
    },

    "stats": {
      ".read": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      "$date": {
        "sessions": {
          "$sid": {
            ".write": "($sid.length <= 32 && $sid.length >= 6) || (auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['ts','ev']) && newData.child('ts').isNumber() && newData.child('ev').hasChildren() && (!newData.hasChild('cat') || (newData.child('cat').isString() && newData.child('cat').val().length <= 32)) && (!newData.hasChild('startedAt') || newData.child('startedAt').isNumber()) && (!newData.hasChild('durMs') || newData.child('durMs').isNumber())",
            "ev": {
              "$key": {
                ".validate": "$key.matches(/^(session|view|click|toggle|open|notice|transition|stop|sticker|error)_[a-zA-Z0-9_]+$/) && newData.isNumber()"
              }
            },
            "$other": {
              ".validate": "$other.matches(/^(ts|startedAt|durMs|cat|ev)$/)"
            }
          }
        }
      }
    }
  }
}
