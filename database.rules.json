{
  "rules": {
    ".read": false,
    ".write": false,

    "buses": {
      ".read": true,
      "$busId": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['dir','trip','ts']) || newData.val() == null"
      }
    },

    "coords": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "viapoints": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())"
    },

    "zones": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "notice": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      ".validate": "newData.hasChildren(['message','level','ts']) || newData.val() == null",
      "message": { ".validate": "newData.isString() && newData.val().length <= 500" },
      "level":   { ".validate": "newData.isString() && newData.val().matches(/^(info|warn|danger)$/)" },
      "ts":      { ".validate": "newData.isNumber()" }
    },

    "counts": {
      ".read": true,
      "$date": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
        ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      }
    },

    "handoff": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      ".validate": "(newData.hasChild('busId') && newData.hasChild('ts')) || newData.val() == null",
      "busId":      { ".validate": "newData.isString() && newData.val().length <= 32" },
      "ts":         { ".validate": "newData.isNumber()" }
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      "theme": { ".validate": "newData.isString() && newData.val().matches(/^(flat|default)$/)" }
    },

    "journal": {
      ".read": true,
      "$date": {
        ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
        ".validate": "$date.matches(/^[0-9]{4}-[0-9]{2}-[0-9]{2}$/)"
      }
    },

    "drivers": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "admins": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
    },

    "stickers": {
      ".read": true,
      ".indexOn": ["ts"],
      "$id": {
        ".write": "!data.exists() || (auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())) || (data.exists() && newData.val() == null && (now - data.child('ts').val()) < 600000)",
        ".validate": "newData.hasChildren(['lat','lng','kind','ts']) && newData.child('lat').isNumber() && newData.child('lng').isNumber() && newData.child('ts').isNumber() && newData.child('kind').isString() && newData.child('kind').val().length <= 16 && (!newData.hasChild('label') || (newData.child('label').isString() && newData.child('label').val().length <= 60)) && newData.child('lat').val() >= 35.125 && newData.child('lat').val() <= 35.150 && newData.child('lng').val() >= 126.915 && newData.child('lng').val() <= 126.970 && newData.child('ts').val() <= (now + 60000) && newData.child('ts').val() >= (now - 300000)"
      }
    },

    "stats": {
      ".read": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
      "$date": {
        "sessions": {
          "$sid": {
            ".write": "auth != null && (root.child('drivers').child(auth.uid).exists() || root.child('admins').child(auth.uid).exists())",
            "flushes": {
              "$flushTs": {
                ".validate": "$flushTs.matches(/^[0-9]+$/) && newData.hasChildren(['ts','ev']) && newData.child('ts').isNumber() && newData.child('ev').hasChildren() && (!newData.hasChild('cat') || (newData.child('cat').isString() && newData.child('cat').val().length <= 32)) && (!newData.hasChild('startedAt') || newData.child('startedAt').isNumber()) && (!newData.hasChild('durMs') || newData.child('durMs').isNumber())",
                "ev": {
                  "$key": {
                    ".validate": "$key.matches(/^(session|view|click|toggle|open|notice|transition|stop|sticker|error)_[a-zA-Z0-9_]+$/) && newData.isNumber()"
                  }
                },
                "$other": {
                  ".validate": "$other.matches(/^(ts|startedAt|durMs|cat|ev)$/)"
                }
              }
            }
          }
        }
      }
    }
  }
}
